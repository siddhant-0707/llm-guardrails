# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
ENVIRONMENT=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=llm-guardrails
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_LOG_LEVEL=INFO

# LLM Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Guardrails Configuration
GUARDRAILS_ENABLED=true
PII_REDACTION_ENABLED=true
CONTENT_POLICY_ENABLED=true
PROMPT_INJECTION_DETECTION_ENABLED=true

# Vector Database Configuration
VECTOR_DB_TYPE=faiss  # Options: faiss, pgvector, qdrant
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DB=vectorstore
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=postgres
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=llm-guardrails-experiments

# Mem0 Configuration
MEM0_API_KEY=your_mem0_api_key_here

# Security
SECRET_KEY=12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Gemini Configuration (Recommended - Free tier available)
GOOGLE_API_KEY=AIzaSyATN38Ene9V1qiSzkpztxh93hR_SEV6FNA
GOOGLE_MODEL=gemini-3-pro-preview
